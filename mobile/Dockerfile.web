# syntax=docker/dockerfile:1
# Hosted trip chat for the AbhiBus app WebViews (static files + nginx).
#   docker build -f Dockerfile.web -t trip-chat-web .
#   docker run -p 8080:8080 -e API_URL=https://chat-api.abhibus.com [-e ENABLE_HARNESS=true] trip-chat-web
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:web \
 && find dist -type f \( -name '*.js' -o -name '*.ttf' -o -name '*.json' -o -name '*.css' -o -name '*.html' \) -size +1k -exec gzip -9 -k {} \;

FROM nginxinc/nginx-unprivileged:1.27-alpine
USER root
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /etc/nginx/templates /etc/nginx/snippets \
 && chown -R 101:101 /etc/nginx/conf.d /usr/share/nginx/html
COPY web/nginx.conf.template /etc/nginx/templates/chat.conf.template
COPY web/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --chmod=755 web/entrypoint.sh /entrypoint.sh
COPY --chown=101:101 --from=build /app/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/entrypoint.sh"]
