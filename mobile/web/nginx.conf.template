# Hosted trip chat (static). ${API_ORIGIN} / ${WS_ORIGIN} are filled in by entrypoint.sh.
# add_header is not inherited once a location sets its own, so every location includes the header set.
map $uri $chat_csp {
  default "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${WS_ORIGIN}; frame-ancestors 'self'; base-uri 'none'; form-action 'none'";
  ~^/harness/ "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGIN}; frame-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'";
}

server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;

  # Stock mime.types has no .ttf entry (served as octet-stream, so never compressed).
  include /etc/nginx/mime.types;
  types { font/ttf ttf; }

  # Files are pre-compressed at build time (gzip -9, Dockerfile.web); on-the-fly gzip is the fallback.
  gzip_static on;
  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json font/ttf image/svg+xml;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  # Content-hashed bundle and assets: cache forever.
  location ~ ^/(_expo|assets)/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Per-environment settings: always fresh.
  location = /config.js {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  location /harness/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/index.html =404;
  }

  # The app shell: never cached, so a deploy reaches every phone on the next open.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
