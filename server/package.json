{
  "name": "abhibus-journey-chat-server",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime Live Journey Companion & Chat — API + WebSocket gateway",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:introspect-abrs": "tsx scripts/introspect-abrs.ts",
    "test:moderation": "tsx scripts/test-moderation.ts",
    "test:partner": "node scripts/test-partner.mjs",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
