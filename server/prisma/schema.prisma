// =============================================================================
//  AbhiBus Live Journey Chat — EPHEMERAL CHAT STORE (MySQL 8+, utf8mb4)
//
//  Lives in the shared AbhiBus database (abrs_new), next to the ABHI_* tables:
//  every table is prefixed chat_. bus-online writes only chat_abhibus_inbox;
//  this service owns all the others.
// =============================================================================
//  Booking truth lives in the AbhiBus booking system, which PUSHES bookings to
//  /v1/partner/*. This database only holds a minimal, privacy-stripped
//  PROJECTION of those bookings for the duration of a trip, plus chat data. Everything journey-scoped is hard-deleted
//  PURGE_AFTER_ARRIVAL_MIN (default 120) after arrival by jobs/expirySweeper.
//
//  Retained beyond purge (by design, needs legal sign-off):
//    - SosEvent       — safety incidents are never auto-deleted with chat.
//    - MessageReport  — a snapshot of a reported message, kept until
//                       `retain_until` so trust & safety can act on it.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("CHAT_DATABASE_URL")
}

enum JourneyStatus {
  SCHEDULED
  IN_TRANSIT
  ARRIVED
  PURGED
}

enum Gender {
  M
  F
  O
}

enum RoomType {
  MAIN_COMMON
  WOMEN_ONLY
}

enum ContentType {
  TEXT
  STICKER
  BUS_LOCATION
  BROADCAST
  LANDMARK // extension: pickup landmark photo card
  SYSTEM   // extension: join notices, game results
}

enum BookingChannel {
  OWN // abrs_reserved_tickets
  API // abrs_api_reserved_tickets
  QR  // guest who joined by scanning a fellow passenger's QR (booked elsewhere, e.g. RedBus) — never F-verified
}

enum EtaGameStatus {
  OPEN
  LOCKED
  RESOLVED
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// One physical bus run. journey_id = "<Service_Id>:<Journey_date>"
model BusJourney {
  journeyId        String        @id @map("journey_id")
  serviceId        String        @map("service_id")
  journeyDate      String        @map("journey_date")
  busNumber        String        @map("bus_number")
  operatorName     String        @map("operator_name")
  /// Trip Rooms platform room this journey is mirrored into (set by the platform bridge).
  platformRoomId   String?       @map("platform_room_id")
  routeName        String        @map("route_name")
  sourceCity       String        @map("source_city")
  destinationCity  String        @map("destination_city")
  startTime        DateTime      @map("start_time")
  estimatedEndTime DateTime      @map("estimated_end_time")
  actualEndTime    DateTime?     @map("actual_end_time")
  purgeAt          DateTime?     @map("purge_at")
  status           JourneyStatus @default(SCHEDULED)
  createdAt        DateTime      @default(now()) @map("created_at")
  /// Ordered stops pushed by the booking system: [{ name, lat, lng, kind?, at?, title?, caption?, imageUrl? }].
  /// Drives progress, "near <town>" labels, pickup landmarks and toll games. Null = time-based progress only.
  route            Json?
  /// Set by the room opener job when the chat rooms were created (CHAT_OPEN_BEFORE_START_MIN before departure).
  roomsOpenedAt    DateTime?     @map("rooms_opened_at")
  /// Latest bus GPS fix pushed by the tracking system (POST /v1/partner/journeys/:id/location).
  lastLat          Float?        @map("last_lat")
  lastLng          Float?        @map("last_lng")
  lastSpeedKmph    Float?        @map("last_speed_kmph")
  lastFixAt        DateTime?     @map("last_fix_at")
  /// true = route is built from passengers' boarding/dropping points; false = the partner sent an explicit route.
  routeAuto        Boolean       @default(true) @map("route_auto")
  /// AbhiBus tracking id for this run (track.abhibus.com ?service=…), used to match the GPS feed.
  trackingRef      String?       @map("tracking_ref")
  /// true = start/end follow the passengers (earliest boarding, latest drop); false = set explicitly via POST /v1/partner/journeys.
  scheduleAuto     Boolean       @default(true) @map("schedule_auto")
  /// Bus operator's helpline (AbhiBus busPartnerDetails), offered for emergencies.
  operatorHelpline String?       @map("operator_helpline")

  bookings PassengerBooking[]
  rooms    ChatRoom[]
  mutes    SeatMute[]
  blocks   SeatBlock[]
  etaGames EtaGame[]

  @@index([status, purgeAt])
  @@index([status, startTime])
  @@map("chat_bus_journey")
}

/// Privacy-stripped projection of abrs_*_reserved_tickets_det.
/// passenger_name exists for spec parity but is NEVER populated.
model PassengerBooking {
  id            String         @id @default(uuid())
  pnrNumber     String         @map("pnr_number")
  journeyId     String         @map("journey_id")
  seatNumber    String         @map("seat_number")
  passengerName String?        @map("passenger_name")
  gender        Gender
  phoneHash     String?        @map("phone_hash") // HMAC-SHA256(phone, pepper) — never the raw number
  customerId    String?        @map("customer_id") // AbhiBus account that booked (ingestion API); used for the ownership check
  /// Passenger name and booking contact phone, AES-256-GCM encrypted (lib/pii.ts). Ops-only; deleted with the chat.
  passengerNameEnc String?     @map("passenger_name_enc") @db.Text
  contactPhoneEnc  String?     @map("contact_phone_enc") @db.Text
  /// Where this passenger gets on and off (also feeds the journey route when routeAuto).
  boardingId       String?     @map("boarding_id")
  boardingName     String?     @map("boarding_name")
  boardingLandmark String?     @map("boarding_landmark") @db.VarChar(255)
  boardingLat      Float?      @map("boarding_lat")
  boardingLng      Float?      @map("boarding_lng")
  boardingAt       DateTime?   @map("boarding_at")
  droppingId       String?     @map("dropping_id")
  droppingName     String?     @map("dropping_name")
  droppingLat      Float?      @map("dropping_lat")
  droppingLng      Float?      @map("dropping_lng")
  droppingAt       DateTime?   @map("dropping_at")
  channel       BookingChannel
  deviceId      String?        @map("device_id")  // seat <-> device binding (anti seat-hijack)
  displayName   String?        @map("display_name") // chosen by the passenger when joining (not the booking name)
  avatarId      String?        @map("avatar_id")    // one of AVATARS in shared/protocol.ts; null = initial
  invitedBy     String?        @map("invited_by")   // QR guests: seat of the passenger whose QR they scanned
  claimedAt     DateTime?      @map("claimed_at")
  syncedAt      DateTime       @default(now()) @updatedAt @map("synced_at")

  journey BusJourney @relation(fields: [journeyId], references: [journeyId], onDelete: Cascade)

  @@unique([journeyId, seatNumber])
  @@index([pnrNumber])
  @@map("chat_passenger_booking")
}

model ChatRoom {
  roomId          String   @id @default(uuid()) @map("room_id")
  journeyId       String   @map("journey_id")
  roomType        RoomType @map("room_type")
  isActive        Boolean  @default(true) @map("is_active")
  pinnedMessageId String?  @map("pinned_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  journey  BusJourney @relation(fields: [journeyId], references: [journeyId], onDelete: Cascade)
  messages Message[]

  @@unique([journeyId, roomType])
  @@map("chat_room")
}

model Message {
  messageId    String      @id @default(uuid()) @map("message_id")
  roomId       String      @map("room_id")
  senderSeat   String?     @map("sender_seat")
  senderHandle String      @map("sender_handle")
  contentType  ContentType @map("content_type")
  payload      Json
  clientMsgId  String?     @map("client_msg_id") // idempotency key for offline retries
  isHidden     Boolean     @default(false) @map("is_hidden")
  /// Private to one seat (Trip Rooms support replies). Null = everyone in the room.
  visibleToSeat String?    @map("visible_to_seat")
  createdAt    DateTime    @default(now()) @map("created_at")

  room      ChatRoom          @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  receipts  ReadReceipt[]
  reactions MessageReaction[]

  @@unique([roomId, senderSeat, clientMsgId])
  @@index([roomId, createdAt])
  @@map("chat_message")
}

/// Spec: (message_id, pnr_number, seen_at). Keyed by seat as well, because one
/// PNR can hold several seats (family bookings) and each reads independently.
model ReadReceipt {
  messageId  String   @map("message_id")
  pnrNumber  String   @map("pnr_number")
  seatNumber String   @map("seat_number")
  seenAt     DateTime @default(now()) @map("seen_at")

  message Message @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, seatNumber])
  @@map("chat_read_receipt")
}

model MessageReaction {
  messageId  String   @map("message_id")
  seatNumber String   @map("seat_number")
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@id([messageId, seatNumber, emoji])
  @@map("chat_message_reaction")
}

/// Survives chat purge (no FK) so trust & safety can act after arrival.
/// Unique per (message, reporter PNR): a family on one PNR counts as ONE report,
/// which stops a group from brigading a stranger into a mute.
model MessageReport {
  id              String   @id @default(uuid())
  journeyId       String   @map("journey_id")
  messageId       String   @map("message_id")
  reporterPnr     String   @map("reporter_pnr")
  reporterSeat    String   @map("reporter_seat")
  reportedSeat    String   @map("reported_seat")
  reason          String
  contentSnapshot Json     @map("content_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")
  retainUntil     DateTime @map("retain_until")

  @@unique([messageId, reporterPnr])
  @@index([journeyId, reportedSeat])
  @@map("chat_message_report")
}

model SeatMute {
  journeyId  String   @map("journey_id")
  seatNumber String   @map("seat_number")
  reason     String
  mutedAt    DateTime @default(now()) @map("muted_at")

  journey BusJourney @relation(fields: [journeyId], references: [journeyId], onDelete: Cascade)

  @@id([journeyId, seatNumber])
  @@map("chat_seat_mute")
}

model SeatBlock {
  journeyId   String   @map("journey_id")
  blockerSeat String   @map("blocker_seat")
  blockedSeat String   @map("blocked_seat")
  createdAt   DateTime @default(now()) @map("created_at")

  journey BusJourney @relation(fields: [journeyId], references: [journeyId], onDelete: Cascade)

  @@id([journeyId, blockerSeat, blockedSeat])
  @@map("chat_seat_block")
}

model EtaGame {
  id             String        @id @default(uuid())
  journeyId      String        @map("journey_id")
  checkpointName String        @map("checkpoint_name")
  checkpointLat  Float         @map("checkpoint_lat")
  checkpointLng  Float         @map("checkpoint_lng")
  status         EtaGameStatus @default(OPEN)
  closesAt       DateTime      @map("closes_at")
  actualAt       DateTime?     @map("actual_at")
  winnerSeat     String?       @map("winner_seat")
  winnerPnr      String?       @map("winner_pnr")
  rewardPoints   Int           @map("reward_points")
  createdAt      DateTime      @default(now()) @map("created_at")

  journey BusJourney @relation(fields: [journeyId], references: [journeyId], onDelete: Cascade)
  guesses EtaGuess[]

  @@index([journeyId, status])
  @@map("chat_eta_game")
}

model EtaGuess {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  pnrNumber  String   @map("pnr_number")
  seatNumber String   @map("seat_number")
  guessAt    DateTime @map("guess_at")
  createdAt  DateTime @default(now()) @map("created_at")

  game EtaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seatNumber])
  @@map("chat_eta_guess")
}

/// Never purged with chat. No FK to journey on purpose.
model SosEvent {
  id             String    @id @default(uuid())
  journeyId      String    @map("journey_id")
  pnrNumber      String    @map("pnr_number")
  seatNumber     String    @map("seat_number")
  lat            Float?
  lng            Float?
  placeLabel     String?   @map("place_label")
  status         SosStatus @default(OPEN)
  createdAt      DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  @@index([status, createdAt])
  @@map("chat_sos_event")
}

/// Leader lease for background jobs, so N server instances run each job once.
model JobLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at")

  @@map("chat_job_lease")
}

/// Raw AbhiBus responses written by bus-online (Webservices_App: GetTicketDetails and
/// ConfirmCancellation), unchanged. The chat service processes them in id order
/// (jobs/inboxProcessor.ts) and deletes them soon after: payloads hold passenger data.
model ChatAbhibusInbox {
  id          BigInt    @id @default(autoincrement())
  /// TICKET = GetTicketDetails response, CANCELLATION = ConfirmCancellation response
  eventType   String    @map("event_type") @db.VarChar(20)
  pnr         String    @db.VarChar(40)
  /// Seats the user asked to cancel (cancellations only)
  cancelSeats String?   @map("cancel_seats") @db.VarChar(255)
  payload     String    @db.LongText
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  /// Delete after this: trip end + INBOX_KEEP_AFTER_TRIP_MIN (abrs_new_chat_tables2.sql). Null = keep.
  keepUntil   DateTime? @map("keep_until") @db.DateTime(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)

  @@index([processedAt, id])
  @@index([keepUntil])
  @@map("chat_abhibus_inbox")
}
