# ---------------------------------------------------------------------------
#  AbhiBus Live Journey Chat — server environment
#  Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=*

# Chat store (ephemeral, auto-purged). Dev/prod: the shared abrs_new database; every table is
# prefixed chat_ (DDL: prisma/sql/abrs_new_chat_tables.sql). Local: any MySQL 8+ database:
#   CREATE DATABASE journey_chat CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'journey_chat'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON journey_chat.* TO 'journey_chat'@'localhost';
# connection_limit is per instance; instances × limit must stay under MySQL max_connections.
CHAT_DATABASE_URL=mysql://journey_chat:CHANGE_ME@127.0.0.1:3306/journey_chat?connection_limit=20

# Chat store switch: yes = the shared demo/dev abrs_new (DEMO_DB_*), where bus-online writes
# chat_abhibus_inbox; no = CHAT_DATABASE_URL above. With yes, set DEMO_MODE=false,
# BOOKING_SOURCE=partner and TRACKING_SOURCE=push (boot refuses DEMO_MODE=true on a shared DB).
USE_DEMO_DB=no
DEMO_DB_HOST=          # cluster WRITER endpoint (not -ro): the chat writes constantly
DEMO_DB_PORT=3306
DEMO_DB_USER=
DEMO_DB_PASSWORD=      # quote it if it contains $ or #
DEMO_DB_NAME=abrs_new
DEMO_DB_CONNECTION_LIMIT=10

# Secrets — generate with:  openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32_xxxxxxxxxxxxxxxx
PHONE_HASH_PEPPER=replace_with_32_plus_random_chars_xxxxxxxx
CONDUCTOR_API_KEY=replace_with_conductor_app_key_min_16
OPS_API_KEY=replace_with_ops_key_min_16_chars

# partner = bookings/GPS are PUSHED by the AbhiBus backend to /v1/partner/* (production)
# mock    = demo tickets, no external DB.   mysql = legacy direct read of abrs_new
BOOKING_SOURCE=mock
# push = route + GPS from the partner API (production).  mock = demo NH 44 simulation
TRACKING_SOURCE=mock
DEMO_MODE=true

# ---- Partner integration (production) -----------------------------------------
# Server-to-server keys for /v1/partner/* (comma-separated; two = zero-downtime rotation).
# Generate with: openssl rand -hex 32
PARTNER_API_KEYS=
# Signed lifecycle events (room.opened, journey.closed, sos.raised) to the AbhiBus backend.
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
# How the app proves the passenger's login:
#   partner = AbhiBus backend calls POST /v1/partner/chat-sessions (recommended; /join is closed)
#   jwt     = app sends its AbhiBus JWT to /v1/journey-chat/join; set APP_JWT_PUBLIC_KEY (RS256/ES256) or APP_JWT_SECRET (HS256)
APP_AUTH_MODE=partner
APP_JWT_PUBLIC_KEY=
APP_JWT_SECRET=
APP_JWT_ISSUER=
APP_JWT_USER_CLAIM=sub
# true = only the AbhiBus account that booked the PNR (customerId) can open its chat
STRICT_PNR_OWNERSHIP=false
# Encrypts passenger name + contact phone at rest (Ops-only). Required in production. openssl rand -hex 32
PII_ENCRYPTION_KEY=

# ---- LEGACY ONLY (BOOKING_SOURCE=mysql): direct read of abrs_new. Not the chat store. ----
# Use a dedicated least-privilege user (SELECT on 4 tables only). See README §6.
DB_ENABLED=false
DB_HOST=dev-db-ar-mysql8-cluster.cluster-ro-cwkquurvokdc.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=journey_chat_ro
DB_PASSWORD=CHANGE_ME
DB_NAME=abrs_new
DB_SSL=true
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=20000
DB_QUERY_TIMEOUT_MS=1500
# Ticket statuses that count as "travelling". VERIFY against abrs_reserved_tickets.Status
ABRS_CONFIRMED_STATUSES=Confirmed,Booked,CONFIRMED,BOOKED,1

# Optional on one instance. REQUIRED as soon as you run 2+ instances (socket.io redis adapter).
# Local: brew install redis && brew services start redis  ->  REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
# Name of this instance in logs and job leases (default hostname:pid)
INSTANCE_ID=
# Journeys processed in parallel by the 30s ticker
TICK_CONCURRENCY=16
# permessage-deflate: ~200 KB RAM per socket. Leave off unless measured otherwise.
WS_COMPRESSION=false

# Safety desk
SUPPORT_WEBHOOK_URL=
SUPPORT_PHONE=

# Product knobs
# Rooms open this many minutes before departure (30 or 45)
CHAT_OPEN_BEFORE_START_MIN=30
# Chat ends this many minutes after the last passenger's drop time (latest droppingDateTime)
CHAT_CLOSE_AFTER_LAST_DROP_MIN=180
REPORT_MUTE_THRESHOLD=3
ETA_GAME_REWARD_POINTS=50

# ---- Trip Rooms platform bridge (optional) -----------------------------------
# Create a key in the Trip Rooms Console → Developer → API keys (scopes: rooms:read,
# rooms:write, members:write, webhooks:write). Unset = the app runs standalone.
PLATFORM_API_URL=
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
PLATFORM_CALLBACK_URL=
