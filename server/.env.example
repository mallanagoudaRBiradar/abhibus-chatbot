# ---------------------------------------------------------------------------
#  AbhiBus Live Journey Chat — server environment
#  Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=*

# Chat store (ephemeral, auto-purged). PostgreSQL — see docker-compose.yml
CHAT_DATABASE_URL=postgresql://chat:chat@localhost:5432/journey_chat?schema=public

# Secrets — generate with:  openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32_xxxxxxxxxxxxxxxx
PHONE_HASH_PEPPER=replace_with_32_plus_random_chars_xxxxxxxx
CONDUCTOR_API_KEY=replace_with_conductor_app_key_min_16
OPS_API_KEY=replace_with_ops_key_min_16_chars

# mock = demo tickets, no external DB.  mysql = read real bookings from abrs_new
BOOKING_SOURCE=mock
TRACKING_SOURCE=mock
DEMO_MODE=true

# ---- abrs_new (Aurora MySQL) — READ-ONLY reader endpoint ------------------
# Use a dedicated least-privilege user (SELECT on 4 tables only). See README §6.
DB_ENABLED=false
DB_HOST=dev-db-ar-mysql8-cluster.cluster-ro-cwkquurvokdc.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=journey_chat_ro
DB_PASSWORD=CHANGE_ME
DB_NAME=abrs_new
DB_SSL=true
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=20000
DB_QUERY_TIMEOUT_MS=1500
# Ticket statuses that count as "travelling". VERIFY against abrs_reserved_tickets.Status
ABRS_CONFIRMED_STATUSES=Confirmed,Booked,CONFIRMED,BOOKED,1

# Optional: horizontal scaling (socket.io redis adapter)
REDIS_URL=

# Safety desk
SUPPORT_WEBHOOK_URL=
SUPPORT_PHONE=

# Product knobs
CHAT_OPEN_BEFORE_START_MIN=30
PURGE_AFTER_ARRIVAL_MIN=120
REPORT_MUTE_THRESHOLD=3
ETA_GAME_REWARD_POINTS=50

# ---- Trip Rooms platform bridge (optional) -----------------------------------
# Create a key in the Trip Rooms Console → Developer → API keys (scopes: rooms:read,
# rooms:write, members:write, webhooks:write). Unset = the app runs standalone.
PLATFORM_API_URL=
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
PLATFORM_CALLBACK_URL=
