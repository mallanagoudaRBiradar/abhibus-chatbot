NODE_ENV=development
PORT=4100
# Local MySQL 8+ (utf8mb4). See platform/README.md for the one-time CREATE DATABASE / USER.
DATABASE_URL=mysql://trip_rooms:CHANGE_ME@127.0.0.1:3306/trip_rooms?connection_limit=10
# openssl rand -hex 32
JWT_SECRET=
WEBHOOK_SIGNING_KEY=
DEMO_MODE=true
# Where the hosted chat screen runs (the dashboard's live traveller view embeds it)
CHAT_WEB_URL=http://localhost:8090
DASHBOARD_URL=http://localhost:5180

# Database switch: yes = shared abrs_new (chat_console_* tables, DBA runs server/prisma/sql/abrs_new_chat_tables1.sql,
# then npm run setup:real); no = DATABASE_URL. With yes, DEMO_MODE must be false.
USE_DEMO_DB=no
DEMO_DB_HOST=
DEMO_DB_PORT=3306
DEMO_DB_USER=
DEMO_DB_PASSWORD=
DEMO_DB_NAME=abrs_new
DEMO_DB_CONNECTION_LIMIT=10
